[{"id":"p_1795006484099","authorId":"u_1794836717981_vgxn11","authorName":"Z.芝","authorAvatar":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1794935029108_922gx_avatar.jpg","text":"歌词的第一句，就像是在说今天。\n\n昨天，是爷爷的忌日。\n\n心情有点复杂。我想，应该是因为十八年来，第一次和爷爷建立了联系。拜了爷爷、折了纸、烧了纸、放了炮仗。和爷爷没有交集的我，今天，也做了一点事情，奶奶什么也没做，或者说什么也做不了。奶奶坐在椅子上看我折纸、拜爷爷的时候在想什么？\n\n剩下的时间一直在搭建这个平台。搭建这个平台的目的，就是为了这一刻我的感想能有家回。\n\n也是因为给阅读器固件进行魔改，才有了这个平台的初步想法诞生。\n\n很心累，但是更开心！因为我学会了更多技能，感觉自己好厉害（虽然跑代码的是ai）。但是我，真得付出了很多很多的心血。没有人懂，也没有人想懂。\n\n晚上，我开始把3D打印的外壳和硬件进行组装。按预期，这个成品应该是非常完美的！却因为前板螺丝不匹配，让我的作品变得粗糙。两颗透明螺丝断在里面，为了使作品更牢固，我用了3D打印胶水进行粘合（还把这胶水挤进螺丝孔里，试图覆盖住瑕疵）。可是胶水流速太大了，好难控制，弄得壳子到处都是……\n\n还因为这个胶水，我发现了自己的缺点。有个辅助的红色套，我从上往下，一直套不到底部。我妈看见了，直接把胶水放在红色套上。这时，我才恍然大悟。悟得不是这个套原来是这样用的，悟得是自己一直以来太轴了！\n\n悟了之后，我感觉自己是个旁观者，一下子纵览了自己的前十几年，看到了好多自己一根筋的时候，觉得自己像个🧸，太笨了……","media":[{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454215_le7gd_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454214_v7l4z_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454216_c2wnx_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454216_pmd94_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006473922_4ip57_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006473920_fqp85_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006475250_nj9yf_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006475249_pavtd_thumb.jpg"}],"music":{"url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454193_50rpi__-_.mp3","title":"我真的受伤了-张学友","duration":211.8530612244898},"image":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795006454215_le7gd_img.jpg","video":null,"visibility":"friends","selectedFriends":[],"location":{"name":"吴川市","addr":"广东省 湛江市"},"likes":[],"comments":[],"createdAt":"2026-11-18T12:54:44.100Z","weather":null,"mood":["😌 平静"],"editedAt":["2026-11-18T15:53:57.176Z","2026-11-23T12:52:40.992Z"],"voice":null},{"id":"p_1795089280728","authorId":"u_1794836717981_vgxn11","authorName":"Z.芝","authorAvatar":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1794935029108_922gx_avatar.jpg","text":"今天降温了。这次应该是真的入冬了吧……\n\n我真的很好面子哈哈，谁都问我冷不冷穿这么少。我嘴上说着不冷，其实那冷风吹得人很是难受。不一会，就连打好几个喷嚏🤧\n\n下午种了草莓，感觉洁癖又好了一点。","media":[{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250106_qi72n_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250105_dlbcb_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250108_bqzrt_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250107_obhtx_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089258131_h9bz5_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089258129_q5h3l_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089266082_1ph6b_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089266080_rqedq_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089273085_6mc97_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089273084_1g3pb_thumb.jpg"}],"music":{"url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250088_1zq3b__.mp3","title":"风的声音 (钢琴曲版)","duration":145.00571428571428},"voice":null,"image":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795089250106_qi72n_img.jpg","video":null,"visibility":"friends","selectedFriends":[],"location":{"name":"吴川市","addr":"广东省 湛江市"},"likes":[],"comments":[],"weather":["🌪 风大"],"mood":["😌 平静"],"createdAt":"2026-11-19T11:54:40.728Z","editedAt":["2026-11-20T07:46:45.637Z"]},{"id":"p_1795531066365","authorId":"u_1794836717981_vgxn11","authorName":"Z.芝","authorAvatar":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1794935029108_922gx_avatar.jpg","text":"昨天，是爷爷阴寿100。好多人都回来了，家里很是热闹。\n\n我们以后会延续这种仪式吗？我觉得不会。那我们以后用什么方式纪念祖宗？或者说，我们还会纪念祖宗吗？我不知道。\n\n今天，参加了芝蔼村里庙的入伙（开光）？席。这个席一点也不好吃，吃饭前各种人物在台上致辞（好讨厌这种形式），吃饭的时候男高音女高音不停地唱歌，我们坐得又离音响近，所以整顿饭难受死了。\n\n但还是挺热闹的，偶尔感受一次，丰富下生活也还行？（我也不知道）\n\n每一次和别人碰杯的时候，都感觉自己又长大了一点嘿嘿。","media":[{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031992_dhrap_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031985_kt8t6_thumb.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031997_uxhd0_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031993_9yx2m_thumb.jpg","xl":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031994_3hceb_xl.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531045532_njxag_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531045527_7bot5_thumb.jpg","xl":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531045529_buwp3_xl.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531051115_57oxq_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531051111_g255j_thumb.jpg","xl":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531051112_wsski_xl.jpg"},{"type":"image","url":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531059930_g6r8e_img.jpg","thumb":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531059928_ngf45_thumb.jpg","xl":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531059929_w5cr6_xl.jpg"}],"music":null,"voice":null,"image":"https://raw.githubusercontent.com/1024z-del/mengli-youzhi/main/social/media/1795531031992_dhrap_img.jpg","video":null,"visibility":"friends","selectedFriends":[],"location":{"name":"吴川市","addr":"广东省 湛江市"},"likes":[],"comments":[],"weather":["🌤 多云"],"mood":["🥰 幸福"],"createdAt":"2026-11-24T14:37:46.365Z","editedAt":["2026-11-24T14:44:29.976Z"]}]